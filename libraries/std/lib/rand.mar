pub struct Rng<R: RandomGenerator> {
    gen: R,
}


pub trait Rand {
    fn random<R: RandomGenerator>(&rng: Rng<R>): Self
}


pub trait RandomGenerator {
    fn next_int(&self): int
}


pub struct Xoshiro256 {
    state: (int, int, int, int),
}


impl Xoshiro256 {
    fn from_seed(seed: (int, int, int, int)): Self {
        Self { state: seed }
    }
}


impl RandomGenerator for Xoshiro256 {
    fn next_int(&self): int {
        let result = 
            (self.state.0 + self.state.3).rotl(24)
            + self.state.0;

        let t = self.state.1 << 17;

        self.state.2 ^= self.state.0;
        self.state.3 ^= self.state.1;
        self.state.1 ^= self.state.2;
        self.state.0 ^= self.state.3;

        self.state.2 ^= t;
        self.state.3 ^= self.state.3.rotl(45);

        result
    }
}


impl<R: RandomGenerator> Rng<R> {
    fn new(gen: R): Self {
        Self { gen }
    }


    fn random<T: Rand>(&self): T {
        T::random(&self)
    }


    fn random_range(&self, range: Range): int {
        self.random::<int>() % range.len() + range.min
    }
}


impl Rand for int {
    fn random<R: RandomGenerator>(&rng: Rng<R>): Self {
        rng.gen.next_int()
    }
}

impl Rand for float {
    fn random<R: RandomGenerator>(&rng: Rng<R>): Self {
        (rng.random::<int>() >> 11) as float / 9007199254740992.0
    }
}


impl Rand for bool {
    fn random<R: RandomGenerator>(&rng: Rng<R>): Self {
        rng.random::<int>() % 2 == 0
    }
}

