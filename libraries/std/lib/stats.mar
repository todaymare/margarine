pub fn sum(values: [int]): int {
    var total = 0;
    for value in values.iter() {
        total += value;
    }
    total
}

pub fn min(values: [int]): Option<int> {
    if values.len() == 0 { return none() }
    var result = values[0];
    for value in values.iter() {
        if value < result { result = value; }
    }
    some(result)
}

pub fn max(values: [int]): Option<int> {
    if values.len() == 0 { return none() }
    var result = values[0];
    for value in values.iter() {
        if value > result { result = value; }
    }
    some(result)
}

pub fn average(values: [int]): float {
    if values.len() == 0 { return 0.0 }
    sum(values) as float / values.len() as float
}

pub fn count(values: [int], target: int): int {
    var result = 0;
    for value in values.iter() {
        if value == target { result += 1; }
    }
    result
}
