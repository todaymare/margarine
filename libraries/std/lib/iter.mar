pub struct Iter<S, R> {
    state: S,
    next: fn(&S): Option<R>,
}


impl<S, R> Iter<S, R> {
    fn __next__(&self): Option<R> {
        (self.next)(&self.state)
    }


    fn new(state: S, next: fn(&S): Option<R>): Self {
        Self {
            state,
            next,
        }
    }


    fn enumerate(self): Iter<(int, Self), (int, R)> {
        Self::new(
            (0, self), 
            |&state: (int, Iter<S, R>)| {
                let result = state.1.__next__()?;
                state.0 += 1;
                some((state.0 - 1, result))
            }
        )
    }


    fn map<M>(self, f: fn(R): M): Iter<Self, M> {
        Self::new(
            self,
            |&state: Self| {
                let result = state.__next__()?;
                let conv = f(result);
                some(conv)
            }
        )
    }
}


impl<S> Iter<S, int> {
    fn count(self): int {
        self.map(|_| 1).sum()
    }


    fn sum(self): int {
        var sum = 0;
        for i in self {
            sum += i
        }

        sum
    }

}


pub trait Iterator<R> {
    fn into(self): Iter<Self, R>
}


impl<S, R> Iterator<R> for Iter<S, R> {
    fn into(self): Iter<Self, R> {
        Self::new(self, |&state: Self| state.__next__())
    }
}
