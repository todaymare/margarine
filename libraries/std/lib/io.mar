mod ffi {
    extern {
        fn "io_read_line" read_line(): Result<str, str>
        fn "io_read_file" read_file_bytes(bytes: Ptr<byte>, len: int): Result<str, str>
        fn "io_write_file" write_file_bytes(
            path_bytes: Ptr<byte>,
            path_len: int,
            bytes: Ptr<byte>,
            len: int,
        ): Result<(), str>
    }
}

pub fn read_line(): Result<str, str> {
    ffi::read_line()
}

pub fn read_file(path: str): Result<str, str> {
    var cstr = root::mem::CStr::from_str(path);
    var result = ffi::read_file_bytes(cstr.ptr(), cstr.len());
    cstr.free();
    result
}

pub fn write_file(path: str, contents: [byte]): Result<(), str> {
    var cstr = root::mem::CStr::from_str(path);
    var bytes = root::mem::alloc(contents);
    var result = ffi::write_file_bytes(
        cstr.ptr(),
        cstr.len(),
        bytes,
        contents.len(),
    );
    cstr.free();
    $ptr_free(bytes, contents.len());
    result
}
