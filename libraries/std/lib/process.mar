mod ffi {
    extern {
        fn "margarineSpawn" spawn_bytes(bytes: Ptr<byte>, len: int): int
    }
}

pub fn spawn(command: str): int {
    var cstr = root::mem::CStr::from_str(command);
    var result = ffi::spawn_bytes(cstr.ptr(), cstr.len());
    cstr.free();
    result
}

@test
fn spawn_returns_success() {
    assert(spawn("true") == 0, "spawn did not return success");
}

@test
fn spawn_returns_exit_code() {
    assert(spawn("exit 7") == 7, "spawn returned the wrong exit code");
}
