pub struct Vec2 {
    x: float,
    y: float,
}

pub fn vec2(x: float, y: float): Vec2 {
    Vec2 { x, y }
}

impl Vec2 {
    fn add(self, other: Vec2): Vec2 {
        Vec2 { x: self.x + other.x, y: self.y + other.y }
    }

    fn sub(self, other: Vec2): Vec2 {
        Vec2 { x: self.x - other.x, y: self.y - other.y }
    }

    fn scale(self, factor: float): Vec2 {
        Vec2 { x: self.x * factor, y: self.y * factor }
    }

    fn dot(self, other: Vec2): float {
        self.x * other.x + self.y * other.y
    }

    fn length_squared(self): float {
        self.dot(self)
    }
}

pub struct Vec3 {
    x: float,
    y: float,
    z: float,
}

pub fn vec3(x: float, y: float, z: float): Vec3 {
    Vec3 { x, y, z }
}

impl Vec3 {
    fn add(self, other: Vec3): Vec3 {
        Vec3 { x: self.x + other.x, y: self.y + other.y, z: self.z + other.z }
    }

    fn sub(self, other: Vec3): Vec3 {
        Vec3 { x: self.x - other.x, y: self.y - other.y, z: self.z - other.z }
    }

    fn scale(self, factor: float): Vec3 {
        Vec3 { x: self.x * factor, y: self.y * factor, z: self.z * factor }
    }

    fn dot(self, other: Vec3): float {
        self.x * other.x + self.y * other.y + self.z * other.z
    }

    fn length_squared(self): float {
        self.dot(self)
    }
}

pub struct Vec4 {
    x: float,
    y: float,
    z: float,
    w: float,
}

pub fn vec4(x: float, y: float, z: float, w: float): Vec4 {
    Vec4 { x, y, z, w }
}

impl Vec4 {
    fn add(self, other: Vec4): Vec4 {
        Vec4 {
            x: self.x + other.x,
            y: self.y + other.y,
            z: self.z + other.z,
            w: self.w + other.w,
        }
    }

    fn sub(self, other: Vec4): Vec4 {
        Vec4 {
            x: self.x - other.x,
            y: self.y - other.y,
            z: self.z - other.z,
            w: self.w - other.w,
        }
    }

    fn scale(self, factor: float): Vec4 {
        Vec4 {
            x: self.x * factor,
            y: self.y * factor,
            z: self.z * factor,
            w: self.w * factor,
        }
    }

    fn dot(self, other: Vec4): float {
        self.x * other.x + self.y * other.y + self.z * other.z + self.w * other.w
    }

    fn length_squared(self): float {
        self.dot(self)
    }
}
