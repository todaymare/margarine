extern {
    fn "margarineEnvVariable" get_bytes(bytes: Ptr<byte>, len: int): Result<str, str>
    pub fn "margarineEnvArgs" args(): [str]
}

pub fn get(key: str): Result<str, str> {
    var cstr = root::mem::CStr::from_str(key);
