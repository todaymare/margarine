struct CowPoint {
    x: int,
    y: int,
}

@test
fn cow_int_list() {
    var a = [1, 2, 3];
    var b = a;
    b[0] = 99;
    assert(a[0] == 1, "COW: int list original unchanged");
    assert(b[0] == 99, "COW: int list copy mutated");

    var c = [CowPoint { x: 1, y: 2 }, CowPoint { x: 3, y: 4 }];
    var d = c;
    d[0] = CowPoint { x: 5, y: 6 };
    assert(c[0].x == 1, "COW: struct field check");
    assert(d[0].x == 5, "COW: struct copy mutated");
}

@test
fn cow_rc_list() {
    var a = [$rc(5), $rc(10), $rc(15)];
    var b = a;

    assert($rc_get(b[0]) == 5, "copy shares same rc elements");

    b[0] = $rc(99);

    assert($rc_get(a[0]) == 5, "COW: original list rc element unchanged");
    assert($rc_get(b[0]) == 99, "COW: copy list rc element mutated");
    assert($rc_get(a[1]) == 10, "COW: original other elements unchanged");
    assert($rc_get(b[1]) == 10, "COW: copy other elements preserved");
}

@test
fn list_concat_appends_and_preserves_source() {
    var a = [1, 2];
    var b = [3, 4];
    a = a.concat(b);

    assert(a.len() == 4, "concat: combined length");
    assert(a[0] == 1 && a[1] == 2 && a[2] == 3 && a[3] == 4, "concat: preserves order");
    assert(b.len() == 2 && b[0] == 3 && b[1] == 4, "concat: source unchanged");

    a.push(5);
    assert(a.len() == 5 && a[4] == 5, "push: uses concat");
}

@test
fn list_concat_detaches_shared_destination() {
    var a = [1, 2];
    var b = a;
    b = b.concat([3]);

    assert(a.len() == 2 && a[0] == 1 && a[1] == 2, "concat: original unchanged");
    assert(b.len() == 3 && b[2] == 3, "concat: copy appended");
}

@test
fn list_concat_self() {
    var a = [1, 2];
    a = a.concat(a);

    assert(a.len() == 4, "concat self: combined length");
    assert(a[0] == 1 && a[1] == 2 && a[2] == 1 && a[3] == 2, "concat self: preserves order");
}

@test
fn list_concat_rc_elements() {
    var a = [$rc(5)];
    var b = [$rc(10)];
    a = a.concat(b);

    assert($rc_get(a[0]) == 5 && $rc_get(a[1]) == 10, "concat: copies rc elements");
    assert($rc_get(b[0]) == 10, "concat: preserves rc source");
}

@test
fn list_slice_splits_and_preserves_source() {
    var a = [1, 2, 3, 4];
    match a.slice(2) {
        some(pair) => {
            assert(pair.0.len() == 2 && pair.0[0] == 1 && pair.0[1] == 2, "slice: left half");
            assert(pair.1.len() == 2 && pair.1[0] == 3 && pair.1[1] == 4, "slice: right half");
        },
        none => assert(false, "slice: valid index returned none"),
    }

    assert(a.len() == 4 && a[0] == 1 && a[3] == 4, "slice: source unchanged");
}

@test
fn list_slice_boundaries_and_invalid_indices() {
    var a = [1, 2];
    match a.slice(0) {
        some(pair) => assert(pair.0.len() == 0 && pair.1.len() == 2, "slice: zero index"),
        none => assert(false, "slice: zero index returned none"),
    }
    match a.slice(2) {
        some(pair) => assert(pair.0.len() == 2 && pair.1.len() == 0, "slice: end index"),
        none => assert(false, "slice: end index returned none"),
    }

    match a.slice(-1) {
        some(_) => assert(false, "slice: negative index returned some"),
        none => (),
    }
    match a.slice(3) {
        some(_) => assert(false, "slice: out-of-bounds index returned some"),
        none => (),
    }
}

@test
fn list_slice_rc_elements() {
    var a = [$rc(5), $rc(10)];
    match a.slice(1) {
        some(pair) => {
            assert($rc_get(pair.0[0]) == 5, "slice: copies left rc element");
            assert($rc_get(pair.1[0]) == 10, "slice: copies right rc element");
        },
        none => assert(false, "slice: valid rc index returned none"),
    }
    assert($rc_get(a[0]) == 5 && $rc_get(a[1]) == 10, "slice: preserves rc source");
}

@test
fn cow_list_field_assign() {
    var a = [CowPoint { x: 1, y: 2 }, CowPoint { x: 3, y: 4 }];
    var b = a;
    b[0].x = 99;
    assert(a[0].x == 1, "COW: field assign - original unchanged");
    assert(b[0].x == 99, "COW: field assign - copy mutated");
}

struct CowBoo {
    far: int,
}

struct CowX {
    boo: [CowBoo],
}

struct CowNested {
    x: CowX,
}

@test
fn cow_nested_list_field_assign() {
    var a = [CowNested {
        x: CowX {
            boo: [CowBoo { far: 1 }, CowBoo { far: 2 }],
        },
    }];
    var b = a;
    b[0].x.boo[1].far = 50;
    assert(a[0].x.boo[1].far == 2, "COW: nested path - original unchanged");
    assert(b[0].x.boo[1].far == 50, "COW: nested path - copy mutated");
}

@test(should_panic)
fn cow_list_write_out_of_bounds_panics() {
    var list = [1];
    list[1] = 99;
}


@test
fn list_iter_traverses_rope_shapes() {
    var flat = [1, 2, 3];
    var flat_sum = 0;
    for value in flat.iter() { flat_sum += value; }
    assert(flat_sum == 6, "iterator: flat list order");

    var left = [1, 2];
    var right = [3, 4];
    var concat = left.concat(right);
    var concat_sum = 0;
    for value in concat.iter() { concat_sum += value; }
    assert(concat_sum == 10, "iterator: concatenated list order");

    match concat.slice(1) {
        some(pair) => {
            var sliced_sum = 0;
            for value in pair.1.iter() { sliced_sum += value; }
            assert(sliced_sum == 9, "iterator: sliced list order");
        },
        none => assert(false, "iterator: valid slice returned none"),
    }

    var empty: [int] = [];
    assert(empty.iter().count() == 0, "iterator: empty list");
}

@test
fn list_iter_does_not_copies_share_cursor() {
    var iter = [7, 8].iter();
    var other = iter;

    match iter.__next__() {
        some(value) => assert(value == 7, "iterator: first shared value"),
        none => assert(false, "iterator: first value missing"),
    }
    match other.__next__() {
        some(value) => assert(value == 7, "iterator: shared cursor advanced"),
        none => assert(false, "iterator: second value missing"),
    }
}

@test
fn list_iter_wrapper_writes_back_cursor() {
    var iter = [7, 8].iter();

    match iter.__next__() {
        some(value) => assert(value == 7, "iterator wrapper: first value"),
        none => assert(false, "iterator wrapper: first value missing"),
    }
    match iter.__next__() {
        some(value) => assert(value == 8, "iterator wrapper: cursor persisted"),
        none => assert(false, "iterator wrapper: second value missing"),
    }
}

@test
fn list_iter_values_copy_independently() {
    var iter = $list_iter([7, 8]);
    var other = iter;

    match $list_iter_next(&iter) {
        some(value) => assert(value == 7, "iterator value: first value"),
        none => assert(false, "iterator value: first value missing"),
    }
    match $list_iter_next(&other) {
        some(value) => assert(value == 7, "iterator value: independent copy"),
        none => assert(false, "iterator value: copied value missing"),
    }
}

@test
fn list_iter_next_unwrap_inout_place() {
    var maybe_iter = some($list_iter([42]));
    match $list_iter_next(&maybe_iter!) {
        some(value) => assert(value == 42, "iterator unwrap inout value"),
        none => assert(false, "iterator unwrap inout returned none"),
    }
}

@test
fn list_deep_rope_flattens_and_iterates() {
    var rope = [0];
    rope = rope.concat([1]);
    rope = rope.concat([2]);
    rope = rope.concat([3]);
    rope = rope.concat([4]);
    rope = rope.concat([5]);
    rope = rope.concat([6]);
    rope = rope.concat([7]);
    rope = rope.concat([8]);
    rope = rope.concat([9]);
    rope = rope.concat([10]);
    rope = rope.concat([11]);
    rope = rope.concat([12]);
    rope = rope.concat([13]);
    rope = rope.concat([14]);
    rope = rope.concat([15]);
    rope = rope.concat([16]);
    rope = rope.concat([17]);

    var sum = 0;
    for value in rope.iter() { sum += value; }
    assert(sum == 153, "iterator: deep rope order");
    assert(rope[0] == 0 && rope[17] == 17, "deep rope: indexed boundaries");

    match rope.slice(1) {
        some(pair) => assert(pair.1[0] == 1 && pair.1[16] == 17, "deep rope: sliced boundaries"),
        none => assert(false, "deep rope: valid slice returned none"),
    }
}

@test
fn list_balanced_rope_max_iterator_frontier() {
    var rope = [0];
    rope = rope.concat(rope);
    rope = rope.concat(rope);
    rope = rope.concat(rope);
    rope = rope.concat(rope);
    rope = rope.concat(rope);
    rope = rope.concat(rope);
    rope = rope.concat(rope);
    rope = rope.concat(rope);
    rope = rope.concat(rope);
    rope = rope.concat(rope);
    rope = rope.concat(rope);
    rope = rope.concat(rope);
    rope = rope.concat(rope);
    rope = rope.concat(rope);
    rope = rope.concat(rope);
    rope = rope.concat(rope);

    assert(rope.len() == 65536, "iterator: max frontier rope length");
    assert(rope.iter().count() == 65536, "iterator: max frontier traversal");
}

@test
fn list_deep_rope_slice_copies_rc_elements() {
    var rope = [$rc(0)];
    rope = rope.concat([$rc(1)]);
    rope = rope.concat([$rc(2)]);
    rope = rope.concat([$rc(3)]);
    rope = rope.concat([$rc(4)]);
    rope = rope.concat([$rc(5)]);
    rope = rope.concat([$rc(6)]);
    rope = rope.concat([$rc(7)]);
    rope = rope.concat([$rc(8)]);
    rope = rope.concat([$rc(9)]);
    rope = rope.concat([$rc(10)]);
    rope = rope.concat([$rc(11)]);
    rope = rope.concat([$rc(12)]);
    rope = rope.concat([$rc(13)]);
    rope = rope.concat([$rc(14)]);
    rope = rope.concat([$rc(15)]);
    rope = rope.concat([$rc(16)]);

    match rope.slice(1) {
        some(pair) => {
            assert($rc_get(pair.1[0]) == 1, "deep slice: first rc element");
            assert($rc_get(pair.1[15]) == 16, "deep slice: last rc element");
        },
        none => assert(false, "deep slice: valid slice returned none"),
    }
    assert($rc_get(rope[0]) == 0 && $rc_get(rope[16]) == 16, "deep slice: source preserved");
}

@test
fn list_deep_rope_index_assignment_updates_target() {
    var rope = [0];
    rope = rope.concat([1]);
    rope = rope.concat([2]);
    rope = rope.concat([3]);
    rope = rope.concat([4]);
    rope = rope.concat([5]);
    rope = rope.concat([6]);
    rope = rope.concat([7]);
    rope = rope.concat([8]);
    rope = rope.concat([9]);
    rope = rope.concat([10]);
    rope = rope.concat([11]);
    rope = rope.concat([12]);
    rope = rope.concat([13]);
    rope = rope.concat([14]);
    rope = rope.concat([15]);

    rope[15] = 99;
    assert(rope[15] == 99, "deep rope mutation: target updated");
}
