struct RcInner {
    rc: Rc<int>,
}

@test
fn rc_basic() {
    var tup = ($rc(1), $rc(2));
    var tup2 = tup;

    var cont = RcInner { rc: $rc(42) };
    var cont2 = cont;
}


struct RcDestroyCounter {
    id: int,
}

struct ImplicitDestroy {}

fn accepts_destroy<T: Destroy>(value: T) {}

@test
fn implicit_destroy_trait() {
    accepts_destroy(ImplicitDestroy {});
    accepts_destroy(42);
    var item = $rc(ImplicitDestroy {});
}

trait NotImplicit {
    fn not_implicit(self)
}

struct NotImplicitStruct {}

fn accepts_not_implicit<T: NotImplicit>(value: T) {}

@test(should_panic)
@silent
fn custom_trait_is_not_implicit_for_function() {
    accepts_not_implicit(NotImplicitStruct {});
}

@test(should_panic)
fn custom_trait_is_not_implicit_for_statement() {
    @silent
    accepts_not_implicit(NotImplicitStruct {});
}

