}

@test
fn bitwise_and_is_not_inout() {
    assert((6 & 3) == 2, "bitwise and changed while adding in-out values");
}

struct InOutValue {
    value: int,
}

@test
fn inout_values() {
    var value = 1;
    increment(&value);
    assert(value == 2, "in-out variable was not updated");
    var field = InOutValue { value: 4 };
    increment(&field.value);
    assert(field.value == 5, "in-out field was not updated");
    var values = [3, 4];
    increment(&values[1]);
    assert(values[1] == 5, "in-out indexed value was not updated");
}

@test
fn inout_multiple_values() {
    var lhs = 10;
    var rhs = 20;
    swap_inout(&lhs, &rhs);
    assert(lhs == 20, "first in-out argument was not swapped");
    assert(rhs == 10, "second in-out argument was not swapped");
}

@test
fn inout_generic_list() {
    var list = [1, 2];
    var list_copy = list;
    replace(&list_copy, [7, 8]);
    assert(list[0] == 1, "in-out list update changed its shared source");
    assert(list_copy[0] == 7, "generic in-out list update failed");
}

@test
fn inout_generic_rc() {
    var rc = $rc(1);
    replace(&rc, $rc(2));
    assert($rc_get(rc) == 2, "generic in-out Rc update failed");
}

@test(should_panic)
@silent
fn inout_requires_marker() {
    var value = 1;
    increment(value);
}

@test(should_panic)
@silent
fn inout_rejects_unexpected_marker() {
    var value = 1;
    accepts_value(&value);
}

@test(should_panic)
@silent
fn inout_rejects_non_place() {
    var value = 1;
    increment(&(value + 1));
}

@test
fn tuple_funcs() {
    var t = make_pair();
    assert(t.0 == 1, "tuple field 0 wrong");
    assert(t.1 == 2, "tuple field 1 wrong");

    var s = swap(t);
    assert(s.0 == 2, "swapped tuple field 0 wrong");
    assert(s.1 == 1, "swapped tuple field 1 wrong");
}


struct UnwrapFoo {
    opt: Option<int>,
}

fn set_unwrap(f: UnwrapFoo): UnwrapFoo {
    f.opt! = 99;
    f
}

fn set_or_return(f: UnwrapFoo): Option<UnwrapFoo> {
    f.opt? = 99;
    some(f)
}

@test
fn unwrap_or_return_struct() {
    var a = UnwrapFoo { opt: some(1) };
    a = set_unwrap(a);
    assert(a.opt! == 99, "unwrap assign failed");

    var b = UnwrapFoo { opt: some(2) };
    var res = set_or_return(b);
    assert(res!.opt! == 99, "or_return payload wrong");
}
