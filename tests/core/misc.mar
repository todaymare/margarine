fn cfg_disabled_declaration() {
    this_name_does_not_exist;
}

@test
@cfg(env("COMPILATION_TARGET"))
fn cfg_compilation_target_is_injected() {
    assert(true, "the compiler did not provide COMPILATION_TARGET");
}

@test
@cfg(env("PATH", "__margarine_cfg_disabled__"))
fn cfg_disabled_test() {
    this_name_does_not_exist;
}

@test
@cfg(all(env("PATH"), not(env("PATH", "__margarine_cfg_disabled__"))))
fn cfg_env_and_logical_predicates() {
    @cfg(env("PATH", "__margarine_cfg_disabled__"))
    this_name_does_not_exist;
