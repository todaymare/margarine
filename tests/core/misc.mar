import "pkg:std" as std;
use std::*;

extern {
    fn inout_extern(&value: int)
}


fn make_pair(): (int, int) {
    (1, 2)
}

fn swap(p: (int, int)): (int, int) {
    (p.1, p.0)
}

fn increment(&value: int) {
    value = value + 1;
}

fn swap_inout(&lhs: int, &rhs: int) {
    var temp = lhs;
    lhs = rhs;
    rhs = temp;
}

fn replace<T>(&value: T, replacement: T) {
    value = replacement;
}

fn accepts_value(value: int) {}

