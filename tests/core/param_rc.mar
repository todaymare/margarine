use std::string::format;

// Regression test: by-value parameters that the callee reassigns must be owned by the
// callee. `format` reassigns its `s` parameter in a loop; the repeated replace_once calls
// used to release the caller's reference, corrupting the refcounts of the caller's
// format string and array elements. With enough iterations the corruption is observable
// as a crash; each call must also release exactly what it owns (no leaks).
@test
fn format_reassigns_param() {
    var i = 0;
    while i < 20000 {
        var s = format("{} {} {} {} {} {}", ["a", "b", "c", "d", "e", "f"]);
        assert(s == "a b c d e f", "format corrupted its output");
        i += 1;
    }
}
