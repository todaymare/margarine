@test
fn closure_basic() {
    var x = 5;
    var f = || { x + 10 };
    assert(f() == 15, "closure capture failed");
}



struct ClosureFoo {
    bar: int,
}

@test
fn closure_struct() {
    var s = ClosureFoo { bar: 3 };
    var f = || { s.bar * 4 };
    assert(f() == 12, "closure struct capture failed");
}


struct IterFoo<T> {}

impl<T> IterFoo<T> {
    fn bar<A>(self, f: fn(T): A) {}
}

@test
fn closure_generic_method() {
    var foo = IterFoo {};
    var n = 42;
    foo.bar(|x| { n + x });
}


struct Container<T> {
    value: T,
}

impl<T> Container<T> {
    fn map<A>(self, f: fn(T): A): Container<A> {
        Container { value: f(self.value) }
    }
}

@test
fn nested_closure_in_generic() {
    var c = Container { value: 42 };
    var c2 = c.map(|n| {
        var inner = || n + 1;
        inner()
    });
}


@test
fn no_capture_closure_basic() {
    var add = |a: int, b: int| { a + b };
    assert(add(10, 20) == 30, "no-capture binary closure failed");

    var constant = || 42;
    assert(constant() == 42, "no-capture nullary closure failed");
}


@test
fn no_capture_closure_higher_order() {
    var c = Container { value: 100 };
    var mapped = c.map(|x: int| x * 2);
    assert(mapped.value == 200, "no-capture closure in higher-order method failed");

    var copy_fn = |x: int| x * 2;
    var mapped2 = c.map(copy_fn);
    assert(mapped2.value == 200, "no-capture closure passed as variable failed");
}



fn takes_inout_callback(callback: fn(&int)) {}


struct InoutCallbackHolder {
    callback: fn(&int),
}

@test
fn function_type_inout_marker_is_preserved_in_struct_field() {
    let holder = InoutCallbackHolder { callback: mutable_callback };
}
fn mutable_callback(&value: int) {}

@test
fn function_type_inout_marker_accepts_matching_function() {
    takes_inout_callback(mutable_callback);
}

@test(should_panic)
@silent
fn function_type_inout_marker_rejects_by_value_closure() {
    takes_inout_callback(|value: int| value);
}

fn invoke_inout_callback(callback: fn(&int), value: int): int {
    callback(&value);
    value
}

@test
fn closure_inout_parameter_is_preserved() {
    var result =
        invoke_inout_callback(
            |&value| {
                value = value + 1;
            },
            1
        );
    assert(result == 2, "inout closure parameter was not written back");
}


struct GenericCallbackHolder<T> {
    callback: T,
}

fn generic_function_type_annotations<T>(value: T, callback: fn(T): T): T {
    let direct: fn(T): T = callback;
    let nested: fn(fn(T): T, T): T = |f: fn(T): T, value: T| f(value);
    nested(direct, value)
}

@test
fn function_type_annotations_resolve_enclosing_generics() {
    let result = generic_function_type_annotations(21, |value| value * 2);
    assert(result == 42, "generic function-type arguments or returns were not resolved");
}

fn generic_function_type_in_struct<T>(callback: fn(T): T, value: T): T {
    let first: GenericCallbackHolder<fn(T): T> = GenericCallbackHolder { callback };
    let second: GenericCallbackHolder<fn(T): T> = first;
    (second.callback)(value)
}

@test
fn equivalent_generic_function_types_share_struct_codegen_type() {
    let result = generic_function_type_in_struct(|value: int| value + 1, 41);
    assert(result == 42, "equivalent function types produced incompatible struct types");
}

fn generic_function_type_in_enum<T>(callback: fn(T): T, value: T): T {
    let first: Option<fn(T): T> = some(callback);
    let second: Option<fn(T): T> = first;
    (second!)(value)
}

@test
fn equivalent_generic_function_types_share_enum_codegen_type() {
    let result = generic_function_type_in_enum(|value: int| value + 1, 41);
    assert(result == 42, "equivalent function types produced incompatible enum types");
}

fn generic_inout_function_type<T>(value: T, callback: fn(&T)): T {
    let saved: fn(&T) = callback;
    saved(&value);
    value
}

@test
fn generic_function_type_preserves_inout_marker() {
    let result = generic_inout_function_type(41, |&value| { value += 1; });
    assert(result == 42, "generic function type lost its inout marker");
}

@silent
fn assign_generic_callback_to_wrong_return<T>(callback: fn(T): T) {
    let wrong: fn(T): bool = callback;
}

@test(should_panic)
@silent
fn generic_function_type_rejects_wrong_return_type() {
    assign_generic_callback_to_wrong_return(|value: int| value);
}


struct GenericSelfCallback<T> {
    value: T,
}

impl<T> GenericSelfCallback<T> {
    fn apply(self, callback: fn(Self): Self): Self {
        let saved: fn(Self): Self = callback;
        saved(self)
    }
}

@test
fn function_type_annotations_resolve_generic_self() {
    let value = GenericSelfCallback { value: 41 };
    let result = value.apply(
        |item: GenericSelfCallback<int>| GenericSelfCallback { value: item.value + 1 });
    assert(result.value == 42, "generic Self in a function type was not resolved");
}
