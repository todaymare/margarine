use std::string::(format, from_ascii, ToStr);

fn main(): int {
    var args = std::env::args();
    if args.len() != 2 {
        println("usage: brainfuck (file)");
        return 1;
    }

    var path = args[1];
    var program =
    match std::io::read_file(path) {
        ok(value) => value,
        err(msg) => {
            println(format("failed to read file '{}': {}", [path, msg]));
            return 1;
        }
    };

    var tape = [];
    var tape_size = 64;
    for _ in 0..tape_size {
        tape.push(0);
    }

    // Each bracket points directly to its matching bracket.
    var jumps = [];
    for _ in 0..program.len() {
        jumps.push(-1);
    }

    var stack = [];
    for i in 0..program.len() {
        var ch = program.slice(i..i + 1);
        if ch == "[" {
            stack.push(i);
        } else if ch == "]" {
            if stack.len() == 0 {
                println(format("unmatched ']' at byte {}", [i.to_str()]));
                return 1;
            }

            var open = stack.pop()!;
            jumps[open] = i;
            jumps[i] = open;
        }
    }

    if stack.len() != 0 {
        println(format("unmatched '[' at byte {}", [stack[stack.len() - 1].to_str()]));
        return 1;
    }

    var ptr = 0;
    var pc = 0;
    while pc < program.len() {
        var ch = program.slice(pc..pc + 1);

        if ch == ">" {
            if ptr == tape_size - 1 {
                println("tape pointer moved past the right edge");
                return 1;
            }
            ptr += 1;
        } else if ch == "<" {
            if ptr == 0 {
                println("tape pointer moved past the left edge");
                return 1;
            }
            ptr -= 1;
        } else if ch == "+" {
            tape[ptr] += 1;
            if tape[ptr] == 256 { tape[ptr] = 0 }
        } else if ch == "-" {
            tape[ptr] -= 1;
            if tape[ptr] == -1 { tape[ptr] = 255 }
        } else if ch == "." {
            if tape[ptr] <= 127 {
                print(from_ascii(tape[ptr])!);
            } else {
                println(format("unsupported output byte {}", [tape[ptr].to_str()]));
                return 1;
            }
        } else if ch == "," {
            match std::io::read_line() {
                ok(input) => {
                    if input.len() == 0 {
                        tape[ptr] = 0;
                    } else {
                        tape[ptr] = input.byte_at(0)! as int;
                    }
                },
                err(msg) => {
                    println(format("failed to read input: {}", [msg]));
                    return 1;
                }
            }
        } else if ch == "[" {
            if tape[ptr] == 0 { pc = jumps[pc] }
        } else if ch == "]" {
            if tape[ptr] != 0 { pc = jumps[pc] }
        }

        pc += 1;
    }

    0
}
